# Groq API Configuration
# Get your API key from the Groq console: https://console.groq.com/keys
GROQ_API_KEY=your_key_here

# Groq AI Model Selection (optional, defaults to qwen/qwen3.8-27b)
# Supported options include: qwen/qwen3.8-27b, openai/gpt-oss-20b, openai/gpt-oss-120b
GROQ_MODEL=qwen/qwen3.8-27b
